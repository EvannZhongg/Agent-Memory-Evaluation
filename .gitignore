# Local/private memory implementations and notes
# C-HyperMem is developed as a standalone memory package; keep this eval repo as a benchmark harness.
C-HyperMem/
参考文献/

# External comparison repos and benchmark mirrors kept locally for analysis.
# Do not vendor these unless you intentionally want to track a fixed fork.
Memory-in-the-LLM-Era-main/

# Optional local clones. These directories are currently tracked in this repo,
# so they are not ignored here. If you later externalize them, uncomment the
# following rules after `git rm --cached -r <dir>`.
# mem0/
# A-mem/
# MemoryOS/
# LongMemEval/

# Local memory/vector stores and generated databases
vectorstores/
**/vectorstores/
**/.chroma/
**/chroma/
**/chromadb/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# LongMemEval large datasets and generated outputs
